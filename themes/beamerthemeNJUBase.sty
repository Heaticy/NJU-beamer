  {\end{njucallout}}
\newenvironment{njuquotegreen}[1]
  {\begin{njucallout}[NJUCalloutGreen]{#1}}
  {\end{njucallout}}
\newenvironment{njuquotegold}[1]
  {\begin{njucallout}[NJUCalloutGold]{#1}}
  {\end{njucallout}}
\newenvironment{njuquoteblack}[1]
  {\begin{njucallout}[NJUCalloutBlack]{#1}}
  {\end{njucallout}}

\newcommand{\njuaccent}[1]{{\color{NJUAccent}\bfseries #1}}
\newcommand{\njumuted}[1]{{\color{NJUMuted}#1}}

% ---- Components shared by every style: stats, marks, chips, steps, meters.

% \NJUstat[color]{figure}{label}{note}: headline number over the same rule
% that callouts use, then a label and an optional muted note.
\newcommand{\NJUstat}[4][NJUPrimary]{%
  \par\noindent
  \begin{tikzpicture}
    \pgfmathsetlengthmacro{\nju@w}{\linewidth}
    \node[anchor=base west,inner sep=0pt,text=#1,font=\sffamily\bfseries\fontsize{20}{21}\selectfont]
      at (0,5pt) {#2};
    \fill[#1!35!white] (0,-.25pt) rectangle (\nju@w,.25pt);
    \fill[#1] (0,-.8pt) rectangle (1.1cm,.8pt);
    \node[anchor=north west,inner sep=0pt,align=left,text width=\nju@w,text=NJUText,
      font=\sffamily\bfseries\fontsize{7.6}{9.4}\selectfont] at (0,-4.5pt)
      {#3\ifstrempty{#4}{}{\\[1pt]{\mdseries\fontsize{6}{7.6}\selectfont\color{NJUMuted}#4}}};
  \end{tikzpicture}\par}

% \NJUmark{text}: marker-pen highlight behind a short phrase.
\newcommand{\NJUmark}[1]{%
  \tikz[baseline=(m.base)]\node[inner xsep=1.2pt,inner ysep=0pt,outer sep=0pt,
    path picture={\fill[NJUGoldLight!62]
      ([yshift=-.20em]path picture bounding box.south west) rectangle
      ([yshift=.40em]path picture bounding box.south east);}] (m) {\bfseries #1};}

% \NJUchip[color]{text}: pill label.
\newcommand{\NJUchip}[2][NJUPrimary]{%
  \tikz[baseline=(c.base)]\node[fill=#1!13!white,text=#1,rounded corners=3.4pt,
    inner xsep=4.2pt,inner ysep=1.7pt,outer sep=0pt,
    font=\sffamily\bfseries\fontsize{6.2}{7.2}\selectfont] (c) {#2};}

% \NJUsteps{a,b,c}: chevron process strip across the line, purple to gold.
\newcommand{\NJUsteps}[1]{%
  \par\noindent
  \begin{tikzpicture}
    \def\nju@n{0}%
    \foreach \nju@s in {#1} {\xdef\nju@n{\the\numexpr\nju@n+1\relax}}
    \pgfmathsetlengthmacro{\nju@t}{6pt}
    \pgfmathsetlengthmacro{\nju@d}{(\linewidth-\nju@t)/\nju@n}
    \pgfmathsetlengthmacro{\nju@h}{19pt}
    \foreach \nju@s [count=\nju@i] in {#1} {
      \pgfmathsetlengthmacro{\nju@x}{(\nju@i-1)*\nju@d}
      \pgfmathsetmacro{\nju@mix}{100-78*(\nju@i-1)/max(1,\nju@n-1)}
      \fill[NJUPrimary!\nju@mix!NJURule] (\nju@x,0) -- (\nju@x+\nju@d-2.4pt,0)
        -- (\nju@x+\nju@d+\nju@t-2.4pt,.5*\nju@h) -- (\nju@x+\nju@d-2.4pt,\nju@h) -- (\nju@x,\nju@h)
        \ifnum\nju@i>1 -- (\nju@x+\nju@t,.5*\nju@h)\fi -- cycle;
      \node[text=white,inner sep=0pt,font=\sffamily\bfseries\fontsize{6.8}{8}\selectfont]
        at (\nju@x+.5*\nju@d+.5*\nju@t,.5*\nju@h) {\nju@s};
    }
  \end{tikzpicture}\par}

% \NJUmeter[color]{fraction}{label}{value}: labelled horizontal meter.
\newcommand{\NJUmeter}[4][NJUPrimary]{%
  \par\noindent
  \begin{tikzpicture}
    \pgfmathsetlengthmacro{\nju@w}{\linewidth}
    \node[anchor=base west,inner sep=0pt,text=NJUText,font=\sffamily\fontsize{7}{8.4}\selectfont]
      at (0,6.5pt) {#3};
    \node[anchor=base east,inner sep=0pt,text=#1,font=\sffamily\bfseries\fontsize{7}{8.4}\selectfont]
      at (\nju@w,6.5pt) {#4};
    \fill[NJUSoft,rounded corners=1.5pt] (0,0) rectangle (\nju@w,3pt);
    \shade[left color=#1,right color=#1!55!NJURule,rounded corners=1.5pt]
      (0,0) rectangle ({max(3pt,#2*\nju@w)},3pt);
  \end{tikzpicture}\par}


